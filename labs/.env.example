# Copy to labs/.env and fill in. Never commit .env.

# Required: an OpenRouter key (https://openrouter.ai/keys).
OPENROUTER_API_KEY=

# The model used for every result in this repo (agent and judge), with OpenRouter's free fallbacks switched off.
AGENT_MODEL=anthropic/claude-haiku-5.5
AGENT_SMALL_MODEL=anthropic/claude-haiku-5.5
AGENT_FALLBACKS=

# AGENT_CACHE=1   # 0 = always call the model (repeated identical requests are replayed from labs/cache)
